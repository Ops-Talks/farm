{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "requireCleanWorkingDir": false,
    "requireUpstream": true,
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": true,
    "pushTags": true
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "../../CHANGELOG.md",
      "strictLatestVersion": false
    }
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "preRelease": false
  },
  "hooks": {
    "before:init": [
      "npm run changelog:sync",
      "npm run lint",
      "npm run test",
      "npm run build"
    ],
    "after:bump": [
      "npm --prefix ../../apps/web version ${version} --no-git-tag-version --allow-same-version",
      "sed -i \"s/^appVersion: .*/appVersion: \\\"${version}\\\"/\" ../../deploy/helm/farm/Chart.yaml",
      "bash ../../scripts/bump-helm-chart-version.sh ../../deploy/helm/farm/Chart.yaml",
      "sed -i \"s|ghcr.io/ops-talks/farm-api:[0-9][0-9A-Za-z.+-]*|ghcr.io/ops-talks/farm-api:${version}|g\" ../../deploy/helm/farm/Chart.yaml",
      "sed -i \"s|ghcr.io/ops-talks/farm-web:[0-9][0-9A-Za-z.+-]*|ghcr.io/ops-talks/farm-web:${version}|g\" ../../deploy/helm/farm/Chart.yaml",
      "sed -i \"s/^appVersion: .*/appVersion: \\\"${version}\\\"/\" ../../deploy/helm/observability/Chart.yaml",
      "bash ../../scripts/bump-helm-chart-version.sh ../../deploy/helm/observability/Chart.yaml"
    ],
    "before:release": "git add ../../CHANGELOG.md ../../apps/web/package.json ../../deploy/helm/farm/Chart.yaml ../../deploy/helm/observability/Chart.yaml"
  }
}
