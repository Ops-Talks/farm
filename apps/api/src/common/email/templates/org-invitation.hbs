{{#> layout}}
<h2>You have been invited to join {{orgName}}</h2>
<p>{{inviterName}} has invited you to join <strong>{{orgName}}</strong> as a <strong>{{role}}</strong>.</p>
<p>This invitation expires in 48 hours.</p>
<p style="margin: 24px 0;">
  <a href="{{acceptUrl}}" style="background: #2563eb; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: 600;">
    Accept Invitation
  </a>
</p>
<p style="color: #6b7280; font-size: 14px;">
  Or copy this link: <a href="{{acceptUrl}}">{{acceptUrl}}</a>
</p>
{{/layout}}
