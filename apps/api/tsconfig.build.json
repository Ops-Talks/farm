{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "resolvePackageJsonExports": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "web",
    "**/*spec.ts",
    "**/__mocks__/**"
  ]
}
