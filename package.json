{
  "name": "farm-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "knip": "knip --reporter compact",
    "knip:ci": "knip --reporter json > knip-report.json",
    "api:dev": "npm run start:dev -w apps/api",
    "api:build": "npm run build -w apps/api",
    "api:test": "npm run test -w apps/api",
    "api:test:e2e": "npm run test:e2e -w apps/api",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:test": "npm run test -w apps/web",
    "web:lint": "npm run lint -w apps/web",
    "test": "npm run api:test && npm run web:test",
    "build": "npm run api:build && npm run web:build",
    "lint": "npm run lint -w apps/api && npm run web:lint"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^10.5.0",
    "fast-xml-parser": "5.9.2",
    "knip": "^6.17.1"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-musl": "16.2.9",
    "@rollup/rollup-linux-x64-musl": "4.62.0",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.1",
    "@unrs/resolver-binding-linux-x64-musl": "1.12.2",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "overrides": {
    "@angular-devkit/core": "19.2.23",
    "@nestjs/core": {
      "path-to-regexp": "8.4.0"
    },
    "@nestjs/swagger": {
      "path-to-regexp": "8.4.0"
    },
    "@nestjs/platform-express": {
      "path-to-regexp": "8.4.0"
    },
    "router": {
      "path-to-regexp": "8.4.0"
    },
    "axios": "1.16.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "release-it": {
      "undici": "6.24.1"
    },
    "picomatch": "4.0.4",
    "follow-redirects": "1.16.0",
    "protobufjs": "7.6.4",
    "js-yaml": "4.2.0",
    "uuid": "14.0.0",
    "fast-xml-parser": "5.9.2",
    "brace-expansion@^1": "1.1.13",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.16",
    "vitest": "4.1.9",
    "ws": "^8.21.0",
    "nodemailer": "^9.0.1",
    "hono": "4.12.25",
    "qs": "6.15.2",
    "typeorm": "1.0.0",
    "@grpc/grpc-js": "1.14.4"
  },
  "knip": {
    "ignoreBinaries": [
      "jq"
    ]
  }
}
