# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=farm

# Application
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=farm
JWT_SECRET=change-me-this-must-be-at-least-32-characters-long

# CORS – comma-separated list of allowed origins; use * to allow all (development only)
ALLOWED_ORIGINS=http://localhost:3000

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=farm-api

# Redis / Caching (optional – leave REDIS_HOST empty for in-memory cache)
REDIS_HOST=
REDIS_PORT=6379
CACHE_TTL=30

# SMTP / Email (optional – leave SMTP_HOST empty to disable email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Farm <noreply@farm.local>

# Swagger UI Basic Auth (protect /api/docs in production)
SWAGGER_USER=farm
SWAGGER_PASSWORD=farm

# Kubernetes / Helm / CRD Discovery (optional -- leave empty to disable)
# Path to a kubeconfig file. Leave empty to use in-cluster config.
KUBECONFIG_PATH=

# Observability backends (optional -- leave empty to disable each integration)
GRAFANA_URL=
GRAFANA_ADMIN_USER=farm
GRAFANA_ADMIN_PASSWORD=farm
PROMETHEUS_URL=http://localhost:9090
TEMPO_URL=http://localhost:3200
LOKI_URL=http://localhost:3100

# OAuth social login (optional -- leave empty to disable)
# GitHub: create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
# Google: create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Integrations (optional -- leave empty to disable)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Alertmanager notification channels (optional -- used by docker-compose.observability.yml)
# Slack: set to enable Slack notifications via Alertmanager (optional – leave empty to disable)
ALERTMANAGER_SLACK_WEBHOOK_URL=
# SMTP: set the following to enable email alerts for critical severity
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_FROM=alerts@example.com
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=
ALERTMANAGER_SMTP_TO=

# Plugin system (optional)
PLUGINS_DIR=./plugins
